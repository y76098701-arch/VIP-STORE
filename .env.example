# Database connection (SQLite default, can be pointed to PostgreSQL)
DATABASE_URL="file:./dev.db"

# NextAuth Authentication
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Initial Administrator Credentials (seeded into database)
ADMIN_EMAIL="admin@vipstore.com"
ADMIN_PASSWORD="admin123456"

# Payment Gateways & Official Account Details
INSTAPAY_NAME="VIP STORE"
INSTAPAY_NUMBER="01069954152"
DAQAN_CASH_NAME="VIP STORE - دكان كاش"
DAQAN_CASH_NUMBER="01069954152"
TRANSFER_PHONE_NUMBER="01069954152"
VODAFONE_CASH_NUMBER="01069954152"

# Discount Configuration (% percentage)
FIRST_ORDER_DISCOUNT="50"
REGULAR_DISCOUNT="20"

# Authorized Free Fire Top-Up Provider Configuration
# Set mode to 'sandbox' for test verification or 'live' for real diamond dispatch
TOPUP_PROVIDER_MODE="sandbox"
TOPUP_PROVIDER_NAME="Garena / Smile.One API"
TOPUP_PROVIDER_URL=""
TOPUP_PROVIDER_API_KEY=""

# Player UID Verification Service
UID_VERIFICATION_ENABLED="false"
UID_VERIFICATION_API_URL=""
UID_VERIFICATION_API_KEY=""

# File Upload Settings
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB="5"
